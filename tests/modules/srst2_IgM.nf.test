nextflow_process {

    name "Test Process SRST2_IGM"
    script "modules/srst2_IgM.nf"
    process "SRST2_IGM"

    test("Should assign correct IgM type") {

        when {
            params {
                outdir = "tests/results"
            }
            process {
                """
                input[0] = ["test", file("${projectDir}/tests/data/input_S999_R1.fastq.gz"), file("${projectDir}/tests/data/input_S999_R2.fastq.gz")]
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
